#, php-format
msgid "The file is too large. The maximum size is %d MB."
msgstr "Plik jest za duży. Maksymalny rozmiar to %d MB."

#, php-format
msgid "The file has no column \"%s\"."
msgstr "Plik nie zawiera kolumny „%s”."

msgid "Catalogue"
msgstr "Katalog utworów"

msgid "Score not found"
msgstr "Nie znaleziono partytury"

#, php-format
msgid "The row has %1$d values, but the header has only %2$d columns."
msgstr "Liczba wartości w wierszu (%1$d) jest większa niż liczba kolumn w nagłówku (%2$d)."

msgid "The signature is missing."
msgstr "Brak sygnatury."

msgid "The signature has leading or trailing spaces."
msgstr "Sygnatura zawiera spacje na początku lub na końcu."

msgid "The signature occurs more than once in the file."
msgstr "Sygnatura występuje w pliku więcej niż raz."

msgid "The signature is used by more than one existing score."
msgstr "Sygnatura jest używana przez więcej niż jedną istniejącą partyturę."

#, php-format
msgid "New scores need the column \"%s\"."
msgstr "Nowe partytury wymagają kolumny „%s”."

msgid "The file is not valid UTF-8. Save it as \"CSV UTF-8\" and try again."
msgstr "Plik nie jest prawidłowo zakodowany w UTF-8. Zapisz go jako \"CSV UTF-8\" i spróbuj ponownie."

msgid "The file is empty."
msgstr "Plik jest pusty."

#, php-format
msgid "The quoted value starting in line %d is not closed."
msgstr "Nie zamknięto cudzysłowu wartości rozpoczynającej się w wierszu %d."

#, php-format
msgid "Column %d of the header has no name."
msgstr "Kolumna %d nagłówka nie ma nazwy."

#, php-format
msgid "The header contains the column \"%s\" more than once."
msgstr "Nagłówek zawiera kolumnę „%s” więcej niż raz."

#, php-format
msgid "%1$s: The value is longer than %2$d characters."
msgstr "%1$s: Wartość przekracza maksymalną liczbę znaków (%2$d)."

#, php-format
msgid "%s: The value is not a date in the form YYYY-MM-DD."
msgstr "%s: Wartość nie jest datą w formacie RRRR-MM-DD."

#, php-format
msgid "%1$s: The value is not one of: %2$s."
msgstr "%1$s: Wartość nie jest jedną z następujących: %2$s."

#, php-format
msgid "%s: The value must not be empty."
msgstr "%s: Wartość nie może być pusta."

#, php-format
msgid "The years for current repertoire must be at least 0 and less than the years for dormant repertoire, which must be at most %d."
msgstr "Liczba lat dla repertuaru bieżącego musi wynosić co najmniej 0 i być mniejsza niż liczba lat dla repertuaru wstrzymanego, która może wynosić najwyżej %d."

msgid "Folder collection not found"
