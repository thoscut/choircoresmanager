{
	"name": "notenarchiv/notenarchiv",
	"description": "Sheet music archive for choirs (Nextcloud app)",
	"license": "AGPL-3.0-or-later",
	"authors": [
		{
			"name": "Thomas Scheel"
		}
	],
	"support": {
		"issues": "https://github.com/thoscut/choircoresmanager/issues",
		"source": "https://github.com/thoscut/choircoresmanager"
	},
	"autoload": {
		"psr-4": {
			"OCA\\Notenarchiv\\": "lib/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"NCU\\": "vendor/nextcloud/ocp/NCU/",
			"OCA\\Notenarchiv\\Tests\\": "tests/",
			"OCP\\": "vendor/nextcloud/ocp/OCP/"
		}
	},
	"scripts": {
		"post-install-cmd": [
			"@composer bin all install --ansi"
		],
		"post-update-cmd": [
			"@composer bin all install --ansi"
		],
		"lint": "find appinfo lib templates tests -name '*.php' -print0 | xargs -0 -n1 php -l",
		"cs:check": "php-cs-fixer fix --dry-run --diff",
		"cs:fix": "php-cs-fixer fix",
		"psalm": "psalm --no-cache --threads=1",
		"test:unit": "phpunit -c tests/phpunit.xml",
		"openapi": "generate-spec",
		"rector": "rector && composer cs:fix"
	},
	"require": {
		"php": "^8.2",
		"bamarni/composer-bin-plugin": "^1.8"
	},
	"require-dev": {
		"doctrine/dbal": "~3.10.4",
		"nextcloud/ocp": "dev-stable33",
		"symfony/console": "^6.4"
	},
	"config": {
		"allow-plugins": {
			"bamarni/composer-bin-plugin": true
		},
		"optimize-autoloader": true,
		"platform": {
			"php": "8.2"
		},
		"sort-packages": true
	},
	"extra": {
		"bamarni-bin": {
			"bin-links": true,
			"forward-command": false,
			"target-directory": "vendor-bin"
		}
	}
}
