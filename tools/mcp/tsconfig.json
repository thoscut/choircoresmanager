{
	"compilerOptions": {
		"target": "ES2023",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2023"],
		"types": ["node"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"exactOptionalPropertyTypes": false,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"declaration": false,
		"sourceMap": false,
		"rootDir": ".",
		"outDir": "dist"
	},
	"include": ["src/**/*.ts", "test/**/*.ts"]
}
